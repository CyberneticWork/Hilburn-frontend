# React SPA (HR frontend) — Hilburn
# Direct URLs like /cybernetic-admin and /dashboard must fall through to index.html.
# Without try_files, nginx returns its own "404 Not Found".
#
# hilburn.cyberneticde.site = this SPA
# apihilburn.cyberneticde.site = Laravel (see backend deploy/nginx-laravel.conf.example)
# Never point apihilburn at this frontend root or at another tenant.

server {
    listen 443 ssl http2;
    server_name hilburn.cyberneticde.site;

    root /var/www/hilburn-frontend/dist;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
